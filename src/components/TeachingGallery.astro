---
import type { TeachingGalleryImage } from '../data/teachingGallery';
import { teachingGalleryImages } from '../data/teachingGallery';

interface Props {
  images?: TeachingGalleryImage[];
  galleryId?: string;
  intro?: string;
}

const {
  images = teachingGalleryImages,
  galleryId = 'teaching-gallery',
  intro = 'Snapshots from tutoring physics, mathematics, and programming — supporting Zimbabwean learners with exam prep, conceptual foundations, and hands-on STEM mentoring.',
} = Astro.props;
---

<div class="max-w-6xl mx-auto" data-teaching-gallery={galleryId}>
  <p class="text-center text-slate-400 mb-8 max-w-3xl mx-auto text-sm md:text-base leading-relaxed">
    {intro}
  </p>
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 md:gap-4">
    {images.map((image, index) => (
      <button
        type="button"
        class="group relative overflow-hidden rounded-lg bg-slate-800 ring-1 ring-slate-700/80 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-400"
        data-gallery-open
        data-index={index}
        aria-label={`View photo ${index + 1}: ${image.alt}`}
      >
        <img
          src={image.src}
          alt={image.alt}
          loading="lazy"
          decoding="async"
          class="w-full h-36 sm:h-40 md:h-44 object-cover transition-transform duration-300 group-hover:scale-105"
        />
        <span class="absolute inset-0 bg-black/0 group-hover:bg-black/25 transition-colors pointer-events-none"></span>
      </button>
    ))}
  </div>
</div>

<div
  class="hidden fixed inset-0 z-[200] h-[100dvh] w-full bg-slate-950/95 backdrop-blur-sm"
  data-gallery-modal={galleryId}
  role="dialog"
  aria-modal="true"
  aria-label="Teaching photo gallery"
>
  <button
    type="button"
    class="absolute top-[max(0.75rem,env(safe-area-inset-top))] right-[max(0.75rem,env(safe-area-inset-right))] z-20 text-slate-200 hover:text-white p-2.5 rounded-lg bg-slate-900/80 hover:bg-slate-800 transition-colors"
    data-gallery-close
    aria-label="Close gallery"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M18 6L6 18M6 6l12 12" />
    </svg>
  </button>

  <button
    type="button"
    class="absolute left-[max(0.25rem,env(safe-area-inset-left))] top-1/2 -translate-y-1/2 z-20 text-slate-200 hover:text-white p-3 rounded-full bg-slate-900/80 hover:bg-slate-800 transition-colors hidden sm:flex"
    data-gallery-prev
    aria-label="Previous photo"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <polyline points="15 18 9 12 15 6" />
    </svg>
  </button>
  <button
    type="button"
    class="absolute right-[max(0.25rem,env(safe-area-inset-right))] top-1/2 -translate-y-1/2 z-20 text-slate-200 hover:text-white p-3 rounded-full bg-slate-900/80 hover:bg-slate-800 transition-colors hidden sm:flex"
    data-gallery-next
    aria-label="Next photo"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <polyline points="9 18 15 12 9 6" />
    </svg>
  </button>

  <div
    class="flex h-full w-full flex-col pt-[max(3.5rem,env(safe-area-inset-top))] pb-[max(1rem,env(safe-area-inset-bottom))] px-3 sm:px-16"
    data-gallery-stage
  >
    <div class="flex min-h-0 flex-1 items-center justify-center touch-pan-y">
      <img
        data-gallery-image
        class="max-h-full max-w-full w-auto h-auto object-contain rounded-lg shadow-2xl select-none"
        src=""
        alt=""
        draggable="false"
      />
    </div>
    <p data-gallery-caption class="shrink-0 text-center text-slate-400 text-sm mt-3 px-2 sm:mt-4"></p>
    <p class="shrink-0 text-center text-slate-500 text-xs mt-1 sm:hidden">Swipe left or right for more photos</p>
  </div>
</div>

<script define:vars={{ galleryId, galleryImages: images }}>
  function initTeachingGallery() {
    const root = document.querySelector(`[data-teaching-gallery="${galleryId}"]`);
    const modal = document.querySelector(`[data-gallery-modal="${galleryId}"]`);
    if (!root || !modal || modal.dataset.galleryReady === 'true') return;

    document.body.appendChild(modal);
    modal.dataset.galleryReady = 'true';

    const imgEl = modal.querySelector('[data-gallery-image]');
    const captionEl = modal.querySelector('[data-gallery-caption]');
    const stage = modal.querySelector('[data-gallery-stage]');
    let current = 0;
    let touchStartX = 0;
    let touchStartY = 0;

    const show = (index) => {
      current = (index + galleryImages.length) % galleryImages.length;
      const item = galleryImages[current];
      if (!(imgEl instanceof HTMLImageElement) || !(captionEl instanceof HTMLElement)) return;
      imgEl.src = item.src;
      imgEl.alt = item.alt;
      captionEl.textContent = `${current + 1} / ${galleryImages.length} — ${item.alt}`;
      modal.classList.remove('hidden');
      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';
    };

    const hide = () => {
      modal.classList.add('hidden');
      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';
    };

    root.querySelectorAll('[data-gallery-open]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const index = Number(btn.getAttribute('data-index') ?? '0');
        show(index);
      });
    });

    const prevBtn = modal.querySelector('[data-gallery-prev]');
    const nextBtn = modal.querySelector('[data-gallery-next]');
    const closeBtn = modal.querySelector('[data-gallery-close]');

    closeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      hide();
    });
    prevBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      show(current - 1);
    });
    nextBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      show(current + 1);
    });

    modal.addEventListener('click', (event) => {
      if (event.target === modal) hide();
    });

    const onKeyDown = (event) => {
      if (modal.classList.contains('hidden')) return;
      if (event.key === 'Escape') hide();
      if (event.key === 'ArrowLeft') show(current - 1);
      if (event.key === 'ArrowRight') show(current + 1);
    };
    document.addEventListener('keydown', onKeyDown);

    const onTouchStart = (event) => {
      if (modal.classList.contains('hidden') || event.touches.length !== 1) return;
      touchStartX = event.touches[0].clientX;
      touchStartY = event.touches[0].clientY;
    };

    const onTouchEnd = (event) => {
      if (modal.classList.contains('hidden') || event.changedTouches.length !== 1) return;
      const touch = event.changedTouches[0];
      const deltaX = touch.clientX - touchStartX;
      const deltaY = touch.clientY - touchStartY;
      if (Math.abs(deltaX) < 50 || Math.abs(deltaX) < Math.abs(deltaY)) return;
      if (deltaX > 0) show(current - 1);
      else show(current + 1);
    };

    stage?.addEventListener('touchstart', onTouchStart, { passive: true });
    stage?.addEventListener('touchend', onTouchEnd, { passive: true });
  }

  initTeachingGallery();
  document.addEventListener('astro:page-load', initTeachingGallery);
</script>
