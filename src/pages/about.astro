---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import ResearchSection from '../components/ResearchSection.astro';
import TeachingSection from '../components/TeachingSection.astro';
import TeachingGallery from '../components/TeachingGallery.astro';
import SectionLink from '../components/SectionLink.astro';
import { teachingGalleryImages } from '../data/teachingGallery';
import SkillsSection from '../components/SkillsSection.astro';
import ContactForm from '../components/ContactForm';
import { getSiteConfig } from '../lib/site';

const site = getSiteConfig();
---

<BaseLayout title="About" description="About Kudzaishe Mwaza — STEM educator, researcher, and tech enthusiast.">
  <Section title="About Me">
    <div class="max-w-3xl mx-auto space-y-4 mb-12">
      {site.bio.map((paragraph) => (
        <p class="text-slate-400 text-lg leading-relaxed">{paragraph}</p>
      ))}
    </div>
  </Section>

  <Section title="Research Interests">
    <ResearchSection />
  </Section>

  <Section title="Teaching & Mentoring">
    <TeachingSection />
    <div class="mt-14">
      <TeachingGallery
        galleryId="teaching-gallery-about"
        images={teachingGalleryImages.slice(0, 6)}
        intro="Highlights from STEM tutoring sessions with students across physics, mathematics, and programming."
      />
    </div>
    <SectionLink href="/teaching" label="View full teaching gallery" />
  </Section>

  <Section title="Skills">
    <SkillsSection />
  </Section>

  <Section title="Get in Touch">
    <ContactForm client:load email={site.email} linkedin={site.linkedin} />
  </Section>
</BaseLayout>
